{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C Program",
      "type": "shell",
      "command": "gcc",
      "args": ["-g", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"],
      "options": {
        "env": {
          "PATH": "${workspaceFolder}\\.vscode\\ucrt64\\bin;${env:PATH}"
        }
      },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}