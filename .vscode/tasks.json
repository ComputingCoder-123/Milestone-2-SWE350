{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C Program",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\ucrt64\\bin\\gcc.exe",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "env": {
          "PATH": "${workspaceFolder}\\.vscode\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
