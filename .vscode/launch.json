{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C: Build and Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}\\.vscode\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "preLaunchTask": "Build C Program",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/.vscode/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "${fileDirname}",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "preLaunchTask": "Build C Program",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}\\.vscode\\ucrt64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}